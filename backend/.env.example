# ConceptLab AI — backend configuration.
# Copy to backend/.env and fill in values:  cp .env.example .env   (PowerShell: Copy-Item .env.example .env)
# backend/.env is git-ignored. Never put secrets in the frontend or in VITE_* variables.

# ---------------------------------------------------------------- App / server
# development | test | production  (production disables /api/docs and expects HTTPS)
APP_ENV=development
LOG_LEVEL=INFO
# SQLAlchemy URL. Default: SQLite file backend/data/conceptlab.db (single-writer deployments).
# DATABASE_URL=sqlite:///E:/path/to/conceptlab.db
DATABASE_URL=
# Private folder for uploaded files (outside any web root). Default: backend/storage
STORAGE_DIR=
# Built frontend served on the same origin in production. Default: ../frontend/dist
FRONTEND_DIST=
# Public URL learners open (used for share links / QR codes).
PUBLIC_BASE_URL=http://localhost:5173
# Comma-separated origins allowed to send state-changing requests (CSRF origin check).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------- Auth / cookies
# Session lifetime in hours (default 14 days).
SESSION_TTL_HOURS=336
# Required true in production, served over HTTPS. Cookies are HttpOnly + SameSite=Lax.
COOKIE_SECURE=false

# ---------------------------------------------------------------- Meta Model API (required for AI features)
# Create a key in the Meta Model API dashboard (https://dev.meta.ai). Leave empty to run
# without AI: labs, sources, simulations and sharing still work; AI buttons report "not configured".
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
# Contributor mode: content may be used to train future Meta models (lower price).
# Standard mode: content is not used for training. Each lab chooses; this is the default for new labs.
DEFAULT_AI_MODE=contributor
MUSE_MODEL_CONTRIBUTOR=muse-spark-1.3-contributor
MUSE_MODEL_STANDARD=muse-spark-1.3
# Optional "deep analysis" model for long/complex documents (standard mode, higher cost).
MUSE_MODEL_DEEP=muse-wonder-1.0
ENABLE_DEEP_ANALYSIS=true
SAM_MODEL=sam-3.1
IMAGE_MODEL=muse-image-1.0
ENABLE_IMAGE_GENERATION=true
ASR_MODEL=muse-voice-transcribe-1.0
# Per-call timeout (seconds) and retries for 429/5xx/timeouts.
AI_TIMEOUT_SECONDS=240
AI_MAX_RETRIES=2
# Reasoning effort for interactive calls (fast) and analysis/generation (deep): none|minimal|low|medium|high
AI_EFFORT_FAST=low
AI_EFFORT_DEEP=medium

# ---------------------------------------------------------------- Limits
MAX_UPLOAD_MB_PDF=40
MAX_UPLOAD_MB_IMAGE=15
MAX_UPLOAD_MB_VIDEO=150
MAX_UPLOAD_MB_AUDIO=15
MAX_VIDEO_SECONDS=300
MAX_SOURCES_PER_LAB=12
# AI requests per hour: anonymous learners (per browser+IP) and signed-in users.
ANON_AI_REQUESTS_PER_HOUR=40
# All anonymous learners behind one IP address together (a whole class shares one school IP).
ANON_AI_REQUESTS_PER_IP_HOUR=600
USER_AI_REQUESTS_PER_HOUR=400
LOGIN_ATTEMPTS_PER_15MIN=10
# New accounts per hour from one IP address (teachers at a workshop share one school IP; raise it for big sign-up sessions).
REGISTRATIONS_PER_HOUR=30
