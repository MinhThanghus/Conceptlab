{
  "description": "Shared test vectors for backend/app/services/expr.py and frontend/src/lib/expr.js. expected may be a number, 'nan', 'inf', '-inf'; error is an ExprError code.",
  "cases": [
    { "expr": "1+2*3", "vars": {}, "expected": 7 },
    { "expr": "(1+2)*3", "vars": {}, "expected": 9 },
    { "expr": "2^3^2", "vars": {}, "expected": 512 },
    { "expr": "-2^2", "vars": {}, "expected": -4 },
    { "expr": "2^-1", "vars": {}, "expected": 0.5 },
    { "expr": "a*x^2+b*x+c", "vars": { "a": 1, "b": -3, "c": 2, "x": 1 }, "expected": 0 },
    { "expr": "a*x^2+b*x+c", "vars": { "a": 2, "b": 1, "c": -1, "x": -2 }, "expected": 5 },
    { "expr": "2x", "vars": { "x": 4 }, "expected": 8 },
    { "expr": "2(x+1)", "vars": { "x": 4 }, "expected": 10 },
    { "expr": "x(x+1)", "vars": { "x": 3 }, "expected": 12 },
    { "expr": "(a+b)(a-b)", "vars": { "a": 5, "b": 3 }, "expected": 16 },
    { "expr": "2pi", "vars": {}, "expected": 6.283185307179586 },
    { "expr": "2*pi*sqrt(L/g)", "vars": { "L": 1, "g": 9.81 }, "expected": 2.0060666807106475 },
    { "expr": "2π√(L/g)", "vars": { "L": 1, "g": 9.81 }, "expected": 2.0060666807106475 },
    { "expr": "x²+x³", "vars": { "x": 2 }, "expected": 12 },
    { "expr": "2πr", "vars": { "r": 0.5 }, "expected": 3.141592653589793 },
    { "expr": "2*π*sqrt(L/g)", "vars": { "L": 0.25, "g": 9.81 }, "expected": 1.0030333403553238 },
    { "expr": "P*(1+r/n)^(n*t)", "vars": { "P": 1000, "r": 0.05, "n": 12, "t": 10 }, "expected": 1647.0094976902801 },
    { "expr": "v0^2*sin(2*theta*deg)/g", "vars": { "v0": 20, "theta": 45, "g": 9.81 }, "expected": 40.774719673802245 },
    { "expr": "e", "vars": {}, "expected": 2.718281828459045 },
    { "expr": "e", "vars": { "e": 1.6 }, "expected": 1.6 },
    { "expr": "sin(pi/2)", "vars": {}, "expected": 1 },
    { "expr": "log(100)", "vars": {}, "expected": 2 },
    { "expr": "log(8, 2)", "vars": {}, "expected": 3 },
    { "expr": "ln(e^2)", "vars": {}, "expected": 2 },
    { "expr": "max(1, 5, 3) - min(4, 2)", "vars": {}, "expected": 3 },
    { "expr": "abs(-3.5)", "vars": {}, "expected": 3.5 },
    { "expr": "1.5e3 + 2", "vars": {}, "expected": 1502 },
    { "expr": "1/0", "vars": {}, "expected": "inf" },
    { "expr": "-1/0", "vars": {}, "expected": "-inf" },
    { "expr": "0/0", "vars": {}, "expected": "nan" },
    { "expr": "sqrt(-1)", "vars": {}, "expected": "nan" },
    { "expr": "ln(0)", "vars": {}, "expected": "-inf" },
    { "expr": "(-8)^(1/3)", "vars": {}, "expected": "nan" },
    { "expr": "0^-1", "vars": {}, "expected": "inf" },
    { "expr": "θ0*2", "vars": { "θ0": 3 }, "expected": 6 },
    { "expr": "v_0*t - 0.5*g*t^2", "vars": { "v_0": 10, "t": 1, "g": 9.8 }, "expected": 5.1 },
    { "expr": "3 × 4 ÷ 2", "vars": {}, "expected": 6 },
    { "expr": "", "vars": {}, "error": "empty" },
    { "expr": "2+", "vars": {}, "error": "unexpected_token" },
    { "expr": "(1+2", "vars": {}, "error": "unexpected_token" },
    { "expr": "sin()", "vars": {}, "error": "bad_arity" },
    { "expr": "1 $ 2", "vars": {}, "error": "unexpected_char" },
    { "expr": "1.2.3", "vars": {}, "error": "bad_number" },
    { "expr": "x+1", "vars": {}, "error": "unknown_variable" },
    { "expr": "__import__", "vars": {}, "error": "unknown_variable" }
  ]
}
